                  "topLevel": false,
                  "allAtoms": [
                    {
                      "atomType": "Output",
                      "x": 0.98,
                      "y": 0.5,
                      "uniqueID": "id-183671",
                      "ioValues": [
                        {
                          "name": "number or geometry",
